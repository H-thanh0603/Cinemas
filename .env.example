# PostgreSQL
# Local Docker Compose: postgresql://cinestar:cinestar@localhost:5432/cinestar?schema=public
# Production (Supabase): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Set the actual DATABASE_URL in the deployment platform (e.g. Vercel env) — never commit it.
DATABASE_URL="postgresql://cinestar:cinestar@localhost:5432/cinestar?schema=public"

# NextAuth (user + admin share this; admin requires role ADMIN in DB)
AUTH_SECRET="change-me-to-a-long-random-string"
# Optional absolute URL for auth callbacks in production
# AUTH_URL="http://localhost:3000"

# Optional: Resend email on confirmed booking
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="CineStar <onboarding@resend.dev>"
# APP_URL="http://localhost:3000"

# Stripe Checkout (required for online payment)
# STRIPE_SECRET_KEY="sk_test_xxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxx"
# APP_URL="http://localhost:3000"

# Development-only fallback; never enable in production
# ENABLE_PAYMENT_SANDBOX="true"

# Vercel Cron: set this env var AND declare schedules in vercel.json. Vercel auto-sends
# `Authorization: Bearer <CRON_SECRET>` on each cron call; the routes require it.
# Protect both /api/cron/expire-bookings and /api/cron/reconcile-payments.
# NOTE: gói Hobby chỉ cho cron chạy 1 lần/ngày (vercel.json đặt 3:17/3:33 UTC
# đúng giới hạn này — ĐỪNG hạ schedule */2 hay */10 khi vẫn ở Hobby: Vercel
# sẽ từ chối deploy. Nâng Pro mới được cron phút.
# Ghế giữ chỗ vẫn được giải phóng kịp thời nhờ lazy-sweep expirePendingBookings()
# chạy trong luồng đặt vé/xác nhận thanh toán — cron chỉ là lưới an toàn.
# CRON_SECRET="your-cron-secret"

# Sentry error tracking (free tier). Khi set DSN, SDK tự kích hoạt ở cả
# server (src/instrumentation.ts) và browser (src/instrumentation-client.ts);
# logger.error() + error boundary sẽ forward exception lên Sentry.
# Không set = hoàn toàn no-op, build/dev không bị ảnh hưởng.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"

# Load test API (/api/loadtest/*) — required for k6 mixed scenario
# LOADTEST_SECRET="change-me-use-a-strong-random-value"

# Upstash Redis (rate limit) — tùy chọn. Cấu hình ĐỦ cả 2 biến thì bộ đếm
# rate limit chạy qua Redis (1 roundtrip/request, scale multi-instance sạch).
# Thiếu 1 trong 2 (hoặc cả hai) → tự động fallback về bảng Postgres
# RateLimitBucket như cũ (src/lib/rate-limit.ts). Tạo database miễn phí tại
# console.upstash.com (Redis → REST API) rồi dán URL + token vào env deploy.
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXXxxxxxxxxxxxxxxxxxxxxxxxxxx"
