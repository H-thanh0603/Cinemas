{
  "name": "cinemas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts prisma",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "catalogue:real": "tsx scripts/replace-demo-movies.ts",
    "db:seed-future": "tsx scripts/seed-future-showtimes.ts",
    "db:setup": "docker compose up -d db && prisma db push && tsx prisma/seed.ts",
    "db:cleanup": "tsx prisma/cleanup.ts",
    "cron:expire": "tsx -e \"import { expirePendingBookings } from './src/lib/booking-expire.ts'; expirePendingBookings().then(n => console.log('expired', n))\"",
    "test:security": "tsx scripts/test-security.ts",
    "test:schema-hardening": "tsx scripts/test-schema-hardening.ts",
    "test:showtime-schedule": "tsx scripts/test-showtime-schedule.ts",
    "test:future-showtimes": "tsx scripts/test-future-showtimes.ts",
    "test:stripe-payment": "tsx scripts/test-stripe-payment.ts",
    "test:payment-fulfillment": "tsx scripts/test-payment-fulfillment.ts",
    "test:admin-auth": "tsx scripts/test-admin-auth.ts",
    "test:admin-2fa": "tsx scripts/test-admin-2fa.ts",
    "test:admin-2fa-http": "tsx scripts/test-admin-2fa-http.ts",
    "test:admin-routes": "tsx scripts/test-admin-routes.ts",
    "test:admin-validation": "tsx scripts/test-admin-validation.ts",
    "test:rate-limit": "tsx scripts/test-rate-limit.ts",
    "test:password-reset": "tsx scripts/test-password-reset.ts",
    "test:booking-concurrency": "tsx scripts/test-booking-concurrency.ts",
    "loadtest": "pwsh -File scripts/k6/run-all.ps1",
    "loadtest:100": "docker run --rm -e BASE_URL=http://host.docker.internal:3000 -e LOADTEST_SECRET=loadtest-dev-secret -e VUS=100 -e DURATION=30s -e BOOK_RATIO=0.1 -v \"%cd%/scripts/k6/mixed.js:/scripts/test.js:ro\" grafana/k6:0.54.0 run /scripts/test.js",
    "build:start": "next build && next start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@sentry/nextjs": "^10.71.0",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.44",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.4.44",
    "sharp": "^0.35.3"
  }
}
